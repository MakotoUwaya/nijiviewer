{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "labels": [
    "renovate"
  ],
  "dependencyDashboard": true,
  "schedule": [
    "before 4am on Saturday"
  ],
  "timezone": "Asia/Tokyo",
  "packageRules": [
    {
      "description": "Automerge minor updates",
      "matchUpdateTypes": [
        "minor"
      ],
      "automerge": true
    },
    {
      "description": "Group Storybook packages",
      "groupName": "storybook",
      "matchPackageNames": [
        "storybook",
        "@storybook/nextjs-vite",
        "@storybook/react",
        "@storybook/addon-links",
        "@storybook/addon-onboarding",
        "@storybook/addon-vitest",
        "msw-storybook-addon",
        "@chromatic-com/storybook"
      ]
    },
    {
      "description": "Group Playwright packages",
      "groupName": "playwright",
      "matchPackageNames": [
        "mcr.microsoft.com/playwright",
        "@playwright/test",
        "playwright"
      ]
    },
    {
      "description": "Group Vitest packages (vitest core + @vitest/* must move together due to peer constraints)",
      "groupName": "vitest",
      "matchPackageNames": [
        "vitest",
        "@vitest/browser",
        "@vitest/browser-playwright",
        "@vitest/coverage-v8"
      ]
    },
    {
      "description": "Group pnpm updates across .mise.toml and package.json",
      "groupName": "pnpm",
      "matchPackageNames": [
        "pnpm"
      ]
    },
    {
      "description": "Vercel での Pagefind ビルド失敗を回避するため apps/docs の Next.js を固定",
      "matchPaths": [
        "apps/docs/**"
      ],
      "matchPackageNames": [
        "next",
        "@next/third-parties"
      ],
      "enabled": false
    }
  ],
  "patch": {
    "enabled": false
  },
  "rangeStrategy": "pin"
}
